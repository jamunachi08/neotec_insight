{
  "name": "neotec-insight-frontend",
  "private": true,
  "version": "3.9.11",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.6.0",
      "onFail": "error"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/require-node.mjs && bash scripts/typecheck.sh && eslint src scripts --max-warnings=0 && npm run test:menu && npm run test:board && npm run test:print && npm run test:statement && npm run test:tree && npm run test:sheet && vite build --base=/assets/neotec_insight/insight/ && node scripts/copy-html-entry.js",
    "preview": "vite preview",
    "lint": "eslint src scripts --max-warnings=0",
    "typecheck": "bash scripts/typecheck.sh",
    "check": "node scripts/require-node.mjs && npm run typecheck && npm run lint && npm run test:menu && npm run test:board && npm run test:print && npm run test:statement && npm run test:tree && npm run test:sheet",
    "test:menu": "node --experimental-strip-types --no-warnings scripts/test-menu-fold.mjs",
    "test:board": "node --experimental-strip-types --no-warnings scripts/test-board.mjs",
    "test:print": "node --experimental-strip-types --no-warnings scripts/test-print.mjs",
    "test:statement": "node --experimental-strip-types --no-warnings scripts/test-statement.mjs",
    "test:tree": "node --experimental-strip-types --no-warnings scripts/test-account-tree.mjs",
    "test:sheet": "node --experimental-strip-types --no-warnings scripts/test-sheet.mjs"
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "fflate": "^0.8.3",
    "html2canvas": "^1.4.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.71.2",
    "vite": "6.4.6"
  },
  "overrides": {
    "postcss": "8.5.28",
    "nanoid": "3.3.19",
    "baseline-browser-mapping": "2.11.26",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    }
  }
}
